{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "predev": "npm run typecheck && npm test",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/copy-python.mjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit.mjs",
    "test:unit": "tsx --test --test-force-exit tests/*.ts",
    "test:py": "tsx scripts/run-pytests.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "node scripts/run-live-e2e.mjs",
    "test:component": "vitest run --config vitest.config.ts",
    "test:component:watch": "vitest --config vitest.config.ts",
    "setup": "npm install && npm run typecheck && npm test && npm run build && npm run e2e:install",
    "e2e:install": "playwright install chromium",
    "catalog": "tsx scripts/catalog.ts",
    "smoke:claude": "tsx scripts/smoke-claude-pane.ts",
    "smoke:handoff": "tsx scripts/smoke-handoff.ts",
    "smoke:kitchen": "node scripts/live-smoke-kitchen.mjs",
    "verify:modeswitch": "tsx scripts/verify-live-modeswitch.ts",
    "verify:modeswitch:agy": "tsx scripts/verify-live-modeswitch-agy.ts",
    "verify:agy-resume": "tsx scripts/verify-agy-resume.ts",
    "sim": "tsx scripts/simulate-voice.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "complexity": "eslint .",
    "complexity:report": "node scripts/complexity-report.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pidusage": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "node-domexception": "file:./stubs/node-domexception"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  }
}
